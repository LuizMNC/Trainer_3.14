# Visitantes configuram as próprias chaves em Configurações — Assistente de IA.
# O backend não utiliza uma chave global como substituta da chave pessoal.

# Senha compartilhada para proteger o TreinerLM publicado na Vercel (tela de login em /login)
# Na Vercel: Settings -> Environment Variables -> adicione TREINERLM_ACCESS_PASSWORD
TREINERLM_ACCESS_PASSWORD=defina_uma_senha_forte_aqui
# Opcional: segredo extra para assinar o cookie de sessão (se omitido, é derivado de TREINERLM_ACCESS_PASSWORD)
# TREINERLM_AUTH_SECRET=gere_um_segredo_aleatorio_longo

# Origem HTTPS extra autorizada para o Assistente de IA (sem caminho ou barra final).
# O domínio trainer-3-14.vercel.app e VERCEL_URL já são reconhecidos pelo servidor.
# TREINERLM_PUBLIC_ORIGIN=https://seu-dominio.example

# Obrigatório para consultas de IA no site público: contador Redis compartilhado.
# Use o endpoint REST HTTPS e token de uma instância Upstash Redis do proprietário.
# Sem estes valores, a IA pública retorna 503 antes de enviar dados ao provedor.
# Nunca utilizar NEXT_PUBLIC_ nestes segredos.
# TREINERLM_AI_REDIS_REST_URL=https://seu-banco.upstash.io
# TREINERLM_AI_REDIS_REST_TOKEN=token_rest_do_proprietario
# TREINERLM_AI_RATE_SECRET=segredo_aleatorio_com_pelo_menos_32_caracteres

# Opcional, exclusivamente no computador do proprietário: Ollama em 127.0.0.1:11434.
# Não habilita Ollama em deploy Vercel e não aceita destinos fornecidos pelo visitante.
# TREINERLM_OLLAMA_ENABLED=1
